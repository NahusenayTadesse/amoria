# Loaded instead of .env's values when vitest runs (mode "test"). The DB tests empty tables, so they
# must never see the development database. `src/lib/server/testing/db.ts` also refuses to run
# against any database whose name does not end in _test.
DATABASE_URL="mysql://dev@localhost:3306/amoria_test"
CHAPA_SECRET_KEY="CHASECK_TEST-unit-tests"
CHAPA_WEBHOOK_SECRET="unit-test-webhook-secret"
FILES_DIR=".tempFiles-test"
