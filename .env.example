# Drizzle
# Replace with your DB credentials!
DATABASE_URL="mysql://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Files (keep outside the deploy folder in production, e.g. ~/amoria-files)
FILES_DIR=".tempFiles"

# Chapa (test keys start CHASECK_TEST / CHAPUBK_TEST)
CHAPA_PUBLIC_KEY=""
CHAPA_SECRET_KEY=""
# Set the same value as the webhook secret in Chapa's dashboard
CHAPA_WEBHOOK_SECRET=""

# A long random string; the cron that calls /api/jobs/tick sends it (§9)
JOBS_SECRET=""

# Web Push (VAPID). Generate a pair with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a mailto: or https: contact for the push services; it defaults to ORIGIN.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
